{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The bundled main window may read themes and settings, save split ratios and receive native preference events.",
  "windows": [
    "main",
    "project-*"
  ],
  "permissions": [
    "allow-app-version",
    "allow-get-theme",
    "allow-get-settings",
    "allow-save-layout",
    "allow-finish-exit",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-open-repository",
    "allow-open-project",
    "allow-initial-repository",
    "allow-recent-repositories",
    "allow-close-repository",
    "allow-repository-status",
    "allow-repository-refs",
    "allow-history-layout",
    "allow-history-rows",
    "allow-commit-details",
    "allow-commit-files",
    "allow-history-position",
    "allow-history-hashes",
    "dialog:allow-open",
    "allow-commit-file-tree",
    "allow-worktree-diff",
    "allow-commit-diff",
    "allow-containing-branches",
    "allow-repository-changes",
    "allow-set-tool-window",
    "allow-selection-preview",
    "allow-inclusion-states",
    "allow-commit",
    "allow-cancel-write",
    "allow-last-commit-message",
    "allow-commit-message-history",
    "allow-rollback",
    "allow-undo-commit",
    "allow-operation-state",
    "allow-sequence",
    "allow-rollback-hunk",
    "allow-rollback-files",
    "allow-create-branch",
    "allow-checkout-branch",
    "allow-checkout-remote-branch",
    "allow-rename-branch",
    "allow-delete-branch",
    "allow-set-upstream",
    "allow-fetch",
    "allow-update-project",
    "allow-abort-update",
    "allow-push",
    "allow-push-preview",
    "allow-commit-and-push",
    "allow-answer-credential"
  ]
}
